{
  "manifest_version": 3,
  "name": "X Auto Unmute",
  "version": "1.0.0",
  "description": "Automatically attempts to unmute videos in your X feed.",
  "permissions": ["storage"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*"],
  "action": {
    "default_title": "X Auto Unmute",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}